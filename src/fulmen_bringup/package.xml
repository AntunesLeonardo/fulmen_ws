<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fulmen_bringup</name>
  <version>0.2.0</version>
  <description>Package containing main launchers and configuration files for general definitions for Fulmen mobile robot.</description>
  <maintainer email="leonardo.antunes.segment155@passinbox.com">AntunesLeonardo</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>fulmen_description</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
